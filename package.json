{
  "name": "ona-ile",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" index.html",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "zone": "python -I tools/build_zone.py data/osm/zone1-post-office_2026-11-07.json public/zones/zone1-post-office.json content/zones/zone1-post-office.overrides.json",
    "android:build": "node scripts/android-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@sentry/browser": "11.10.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
